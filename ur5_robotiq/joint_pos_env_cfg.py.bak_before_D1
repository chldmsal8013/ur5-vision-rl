# ═══════════════════════════════════════════════════════════════════
# Custom event & reward functions for target-aware pick task
# ═══════════════════════════════════════════════════════════════════

def randomize_target_id(env, env_ids):
    """리셋 시 각 env에 target_id (0=red or 1=blue) 랜덤 지정"""
    if not hasattr(env, "_target_id_buf"):
        env._target_id_buf = torch.zeros(env.num_envs, dtype=torch.long, device=env.device)
    # 리셋되는 env들만 새로 랜덤 값 지정
    env._target_id_buf[env_ids] = torch.randint(0, 2, (len(env_ids),), device=env.device)


def get_target_object_pos(env):
    """target_id에 맞는 큐브 world position 반환 (num_envs, 3)"""
    if not hasattr(env, "_target_id_buf"):
        env._target_id_buf = torch.zeros(env.num_envs, dtype=torch.long, device=env.device)
    red_obj: RigidObject = env.scene["object"]
    blue_obj: RigidObject = env.scene["distractor"]
    # target_id == 0 -> red, target_id == 1 -> blue
    target_ids = env._target_id_buf.unsqueeze(-1)  # (N, 1)
    return torch.where(target_ids == 0, red_obj.data.root_pos_w, blue_obj.data.root_pos_w)


def reaching_target(env, std, ee_frame_cfg):
    """target 큐브까지의 거리 (tanh kernel, Franka lift 스타일)"""
    ee_frame: FrameTransformer = env.scene[ee_frame_cfg.name]
    target_pos = get_target_object_pos(env)
    ee_pos = ee_frame.data.target_pos_w[..., 0, :]
    dist = torch.norm(target_pos - ee_pos, dim=1)
    return 1 - torch.tanh(dist / std)


def lifting_target(env, minimal_height):
    """target 큐브가 world Z minimal_height 이상이면 1 (Franka lift 원본과 동일)"""
    if not hasattr(env, "_target_id_buf"):
        env._target_id_buf = torch.zeros(env.num_envs, dtype=torch.long, device=env.device)
    red_obj: RigidObject = env.scene["object"]
    blue_obj: RigidObject = env.scene["distractor"]
    target_ids = env._target_id_buf
    # world Z 좌표 (원본과 동일)
    red_z = red_obj.data.root_pos_w[:, 2]
    blue_z = blue_obj.data.root_pos_w[:, 2]
    target_z = torch.where(target_ids == 0, red_z, blue_z)
    return (target_z > minimal_height).float()


def target_goal_distance(env, std, minimal_height, command_name):
    """target 큐브가 goal 위치까지 도달하는 정도 (Franka lift 원본 로직 + target-aware)"""
    if not hasattr(env, "_target_id_buf"):
        env._target_id_buf = torch.zeros(env.num_envs, dtype=torch.long, device=env.device)
    red_obj: RigidObject = env.scene["object"]
    blue_obj: RigidObject = env.scene["distractor"]
    robot: RigidObject = env.scene["robot"]
    
    # target 큐브 world position 선택 (target_id에 따라)
    target_ids = env._target_id_buf.unsqueeze(-1)
    target_pos_w = torch.where(target_ids == 0, red_obj.data.root_pos_w, blue_obj.data.root_pos_w)
    
    # command에서 goal (robot base frame)
    command = env.command_manager.get_command(command_name)
    des_pos_b = command[:, :3]
    # base frame -> world frame (rotation 포함, 원본과 동일)
    des_pos_w, _ = combine_frame_transforms(robot.data.root_pos_w, robot.data.root_quat_w, des_pos_b)
    
    # target vs goal 거리
    distance = torch.norm(des_pos_w - target_pos_w, dim=1)
    # lifted 조건 (world Z, 원본과 동일)
    return (target_pos_w[:, 2] > minimal_height) * (1 - torch.tanh(distance / std))


def target_id_obs(env):
    """target_id를 one-hot으로 관측 (num_envs, 2)"""
    if not hasattr(env, "_target_id_buf"):
        env._target_id_buf = torch.zeros(env.num_envs, dtype=torch.long, device=env.device)
    return torch.nn.functional.one_hot(env._target_id_buf, num_classes=2).float()


def cube_positions_env_local(env):
    """두 큐브의 env-local position 관측 (num_envs, 6) = [red_pos, blue_pos]"""
    red_obj: RigidObject = env.scene["object"]
    blue_obj: RigidObject = env.scene["distractor"]
    red_pos = red_obj.data.root_pos_w - env.scene.env_origins
    blue_pos = blue_obj.data.root_pos_w - env.scene.env_origins
    return torch.cat([red_pos, blue_pos], dim=-1)


